# 非敏感配置（Cloudflare Pages > Settings > Variables and Secrets）
GITHUB_OWNER=your-github-owner
GITHUB_REPO=hobby-lobby-catalog
GITHUB_BRANCH=main
ADMIN_EMAILS=admin@example.com
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_PAGES_PROJECT=hobby-lobby-catalog

# 必须在 Cloudflare 中标记为 Secret，绝不能写入本文件的真实值
GITHUB_TOKEN=store-as-cloudflare-secret
CF_API_TOKEN=store-as-cloudflare-secret
