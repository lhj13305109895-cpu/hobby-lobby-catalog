<view class="detail-page"><view class="eyebrow">HOBBY LOBBY / CUSTOM MADE</view><view class="headline">{{t.customTitle}}</view><view class="contact-lead muted">{{t.customLead}}</view><view class="steps"><view><text class="red">01</text>　{{lang === 'zh' ? '选择花色或提供图案' : 'Choose a pattern or send artwork'}}</view><view><text class="red">02</text>　{{lang === 'zh' ? '确认型号、容量与配色' : 'Confirm model, capacity and colours'}}</view><view><text class="red">03</text>　{{lang === 'zh' ? '联系沟通定制需求' : 'Discuss your custom requirements'}}</view></view><view class="section-label">{{t.contact}}</view><image class="contact-qr" src="{{wecom}}" mode="widthFix" data-image="{{wecom}}" bindtap="preview" show-menu-by-longpress/><view class="footnote">{{t.contactHint}}</view><image class="contact-card" src="{{card}}" mode="widthFix" data-image="{{card}}" bindtap="preview" show-menu-by-longpress/><button class="secondary" data-image="{{card}}" bindtap="preview">{{t.card}} ↗</button></view>
