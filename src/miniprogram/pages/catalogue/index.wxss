.catalogue-page{padding-bottom:24rpx}.catalogue-page .brand-row{padding-top:18rpx}.catalogue-page .language{width:auto;min-width:96rpx;flex:none;margin:0}.catalogue-page .hero{padding:18rpx 28rpx 20rpx}.catalogue-page .hero .headline{font-size:44rpx;margin:12rpx 0}.catalogue-page .filters{padding:16rpx 20rpx}.model-cards{display:flex;gap:10rpx;margin-top:14rpx}.model-card{flex:1;min-width:0;margin:0;padding:6rpx 4rpx 10rpx;background:#fffcf7;color:#62574b;border:2rpx solid #e2d7c9;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:22rpx;line-height:1.4;overflow:hidden}.model-card image{width:100%;height:156rpx;margin-bottom:8rpx;background:transparent}.model-all{flex:.7;font-size:23rpx}.model-card.active{border-color:#9b302f;color:#9b302f;background:#f4e8df}.catalogue-page .catalogue-body{align-items:flex-start;padding-right:14rpx}.catalogue-page .directory{position:sticky;top:0;height:calc(100vh - env(safe-area-inset-bottom));padding-bottom:16rpx;box-sizing:border-box;align-self:flex-start}.catalogue-page .results{flex:1;min-width:0}.series-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:24rpx 4rpx 18rpx;font-family:Georgia,"Songti SC",serif;font-size:29rpx;border-top:1rpx solid #ddd0c0;margin-top:26rpx}.series-section:first-of-type .series-heading{margin-top:0}.series-total{font-family:Arial,sans-serif;font-size:22rpx;color:#9b302f}.list-bottom{height:calc(24rpx + env(safe-area-inset-bottom))}
