<view class="detail-page">
  <view class="eyebrow">HOBBY LOBBY / SELECTION</view><view class="headline">{{t.selection}}<text class="red"> ({{items.length}})</text></view>
  <view class="footnote">{{t.exportHint}}</view>
  <view wx:if="{{!items.length}}" class="empty"><view>{{t.basketEmpty}}</view><view class="muted">{{t.basketHint}}</view><button class="primary" bindtap="browse">{{t.back}}</button></view>
  <view wx:for="{{items}}" wx:key="key" class="basket-item"><image src="{{item.thumb}}" mode="aspectFit" lazy-load data-id="{{item.productId}}" bindtap="detail"/><view class="basket-content"><text class="code">{{item.code}}</text><view>{{item.title}}</view><view class="muted">{{item.offer.id}}</view><view class="muted">{{item.offer.pcsPerCarton}} {{t.pcs}} / {{t.carton}}</view><view class="quantity-row"><text>{{t.quantity}}</text><input class="quantity-input" type="number" maxlength="6" value="{{item.quantity}}" disabled="{{exporting}}" data-id="{{item.productId}}" data-capacity="{{item.offer.id}}" bindinput="quantity"/></view><view class="muted">{{t.totalPieces}}: {{item.pieces}} {{t.pcs}}</view><button class="remove" disabled="{{exporting}}" data-id="{{item.productId}}" data-capacity="{{item.offer.id}}" bindtap="remove">{{t.remove}}</button></view></view>
  <view wx:if="{{items.length}}" class="export-actions"><button class="primary" data-format="pdf" bindtap="exportSelection" disabled="{{exporting}}" loading="{{exporting && exportFormat === 'pdf'}}">{{exporting && exportFormat === 'pdf' ? t.exporting : exportPaths.pdf ? t.openPdf : t.exportPdf}}</button><button class="secondary export-excel" data-format="xlsx" bindtap="exportSelection" disabled="{{exporting}}" loading="{{exporting && exportFormat === 'xlsx'}}">{{t.exportExcel}}</button></view>
</view>
