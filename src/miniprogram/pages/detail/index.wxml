<view class="detail-page" wx:if="{{product}}"><view class="eyebrow">HOBBY LOBBY / {{product.model}}</view><image class="detail-image" src="{{product.image}}" mode="aspectFit" bindtap="preview" show-menu-by-longpress/><view class="muted center">{{t.preview}}</view><view class="detail-heading"><text class="code">{{product.code}}</text><view class="headline">{{product.title}}</view><text class="muted">{{product.series}}</text></view><view class="section-label">{{t.choose}}</view><button wx:for="{{product.offers}}" wx:key="id" class="offer {{item.selected ? 'chosen' : ''}}" data-capacity="{{item.id}}" bindtap="choose"><view><text>{{item.id}}</text><view class="muted">{{t.packing}}: {{item.packing}}</view></view><text>{{item.selected ? '✓' : '+'}}</text></button><button class="primary" bindtap="basket">{{t.selection}} →</button><view class="footnote">{{t.note}}</view><button class="secondary" open-type="share">{{lang === 'zh' ? '分享此花色' : 'Share this pattern'}}</button></view><view wx:else class="empty">{{t.missing}}</view>
